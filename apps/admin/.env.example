# Copy to `.env.local` (git-ignored) and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API Keys

# Public – bundled into the browser. Safe only because all data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY secret key (bypasses RLS). Never prefix with NEXT_PUBLIC_, never import it
# from client components. Only needed later for privileged server jobs (e.g. inviting staff).
SUPABASE_SECRET_KEY=

# Map provider: none | google | mapbox  (provider keys are added when maps are implemented)
NEXT_PUBLIC_MAP_PROVIDER=none

# SERVER-ONLY. The dashboard's public address, used in password-reset email links, e.g.
# https://admin.example.org. Required in production (never derived from request headers
# there). In development it defaults to the address the request came to.
# The value + /*/auth/callback must be in Supabase → Authentication → URL Configuration →
# Redirect URLs, or Supabase refuses to send the link.
ADMIN_SITE_URL=
