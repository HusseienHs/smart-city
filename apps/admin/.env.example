# Copy to `.env.local` (git-ignored) and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API Keys

# Public – bundled into the browser. Safe only because all data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY secret key (bypasses RLS). Never prefix with NEXT_PUBLIC_, never import it
# from client components. Only needed later for privileged server jobs (e.g. inviting staff).
SUPABASE_SECRET_KEY=

# Map provider: none | google | mapbox  (provider keys are added when maps are implemented)
NEXT_PUBLIC_MAP_PROVIDER=none
