# Copy to `.env` (git-ignored) and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API Keys
#
# Every EXPO_PUBLIC_* variable is bundled INTO THE APP and visible to anyone.
# Only use the publishable (or legacy "anon") key here — it is safe because all data access
# is protected by Row Level Security. NEVER put the secret / service_role key in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Map provider: none | google | mapbox  (provider keys are added when maps are implemented)
EXPO_PUBLIC_MAP_PROVIDER=none
