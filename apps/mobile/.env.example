# Copy to `.env` (git-ignored) and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API Keys
#
# Every EXPO_PUBLIC_* variable is bundled INTO THE APP and visible to anyone.
# Only use the publishable (or legacy "anon") key here — it is safe because all data access
# is protected by Row Level Security. NEVER put the secret / service_role key in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Map provider for the Explore map (react-native-maps):
#   none / mapbox → the platform default (Apple Maps on iOS, Google Maps on Android)
#   google        → Google Maps on iOS too (needs GOOGLE_MAPS_API_KEY in iOS builds)
EXPO_PUBLIC_MAP_PROVIDER=none

# Google Maps key for production Android builds (not needed in Expo Go). Read by app.config.js
# at build time, NOT bundled as JS. Restrict it in Google Cloud to this app's package name and
# signing certificate SHA-1, and to the Maps SDKs. Prefer an EAS secret for store builds.
GOOGLE_MAPS_API_KEY=
