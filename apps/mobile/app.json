{
  "expo": {
    "name": "Smart City",
    "slug": "smart-city",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartcity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "he": "./locales/he.json",
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#007072",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": ["he", "ar", "en"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart City uses your location to mark where the problem you are reporting is. It is used only while you create a report.",
          "locationFullAccuracyPermission": "Precise location helps the municipality find the exact spot of the problem you report.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Smart City uses the camera so you can photograph the problem you are reporting.",
          "photosPermission": "Smart City accesses your photos so you can attach pictures of the problem to your report.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
